{
  "name": "puzzlewump",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "gen:audio": "node scripts/gen-audio.js",
    "gen:icons": "node scripts/gen-icons.js",
    "gen:logo": "node scripts/gen-logo.js"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|zustand)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
